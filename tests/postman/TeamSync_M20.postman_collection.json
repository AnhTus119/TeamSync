{
  "info": {
    "name": "TeamSync — M20 Tài khoản & phân quyền",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Chạy theo thứ tự bằng Collection Runner trên DB vừa seed. Postman tự giữ cookie đăng nhập giữa các request. Chạy lại nhiều lần được, không cần seed lại."
  },
  "item": [
    {
      "name": "1. Xác thực",
      "item": [
        {
          "name": "Đăng ký tài khoản mới",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"role = student, không lộ mật khẩu\", () => { const d = pm.response.json().data; pm.expect(d.role).to.eql(\"student\"); pm.expect(d).to.not.have.property(\"password_hash\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sv{{$timestamp}}@teamsync.local\",\n  \"password\": \"123456\",\n  \"full_name\": \"Sinh viên mới\"\n}"
            }
